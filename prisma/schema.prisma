// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  // Supabase pooler in transaction mode (port 6543, ?pgbouncer=true), built
  // for many concurrent short-lived connections — what this app's Session
  // queries need. `prisma migrate deploy` is intentionally NOT run at boot
  // (see package.json `setup`/`migrate:deploy`): it needs session-level
  // locking that neither this pooler nor Supabase's session-mode pooler
  // (capped, often externally saturated) can reliably provide, and the only
  // migration in this repo has been applied for months. Run
  // `npm run migrate:deploy` manually against a working direct connection
  // if a new migration is ever added.
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
